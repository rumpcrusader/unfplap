# Godot editor cache
.godot/

# Generated resource UIDs. This mod loads every script by path, so it does not
# need stable UIDs and Godot recreates these files on demand.
*.uid

# Generated release notes; CI writes them outside the repository.
release_notes.md

# Local build/export output
/build/
/dist/
*.pck
*.zip

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*~
*.tmp
*.bak
*.orig
*.log
last-run.log

# Python helper cache
__pycache__/
*.pyc

# The pose lab scene carries a saved copy of the rigs and is generated by opening it; the
# exported poses/missionary_pose.json is the tracked source of truth.
tools/pose_lab.tscn

# Local anatomy working files. The release anatomy assets are tracked.
assets/anatomy/*.blend
!assets/anatomy/mare_bits_v2.blend
assets/anatomy/*.blend1
assets/anatomy/backups/
assets/anatomy/winking_before_wink.scn
