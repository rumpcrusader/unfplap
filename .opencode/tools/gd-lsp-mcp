# self-test


def self_test():
    """Prove the whole path against a throwaway project; never touches a real checkout."""
    failures = []

    def check(name, condition, detail=""):
        print("%-52s %s%s" % (name, "ok" if condition else "FAIL", "" if condition else "  " + detail))
        if not condition:
            failures.append(name)

    base = tempfile.mkdtemp(prefix="gdtest-", dir=_self_test_parent())
    project = None
    origin = os.getcwd()
    try:
        with open(os.path.join(base, "project.godot"), "w", encoding="utf-8") as f:
            f.write(
                'config_version=5\n\n[application]\n\nconfig/name="gdtest"\n'
                'config/features=PackedStringArray("4.5")\n'
            )
        with open(os.path.join(base, "a.gd"), "w", encoding="utf-8") as f:
            f.write(
                "extends Node\n"
                "\n"
                "\n"
                "## Adds two numbers.\n"
                "func add(left: int, right: int) -> int:\n"
                "\treturn left + right\n"
                "\n"
                "\n"
                "func call_it() -> int:\n"
                "\treturn add(1, 2)\n"
            )
        with open(os.path.join(base, "b.gd"), "w", encoding="utf-8") as f:
            f.write(
                "extends Node\n"
                "\n"
                "\n"
                "func other() -> int:\n"
                '\tvar a: Node = preload("res://a.gd").new()\n'
                '\treturn a.call("add", 3, 4)\n'
            )
        with open(os.path.join(base, "broken.gd"), "w", encoding="utf-8") as f:
            f.write("extends Node\n\n\nfunc broken( -> void:\n")

        project = Project(base)
        os.chdir(base)
        started = time.time()
        project.ensure_client()
        boot = time.time() - started
        check("daemon boots for a fresh project", True, "")

        status = tool_gd_status({})
        check("gd_status names the root and the log", base in status and ".log" in status, status)
        check("gd_status reports a port", "port" in status, status)

        hover = tool_gd_hover({"path": os.path.join(base, "a.gd"), "symbol": "call_it"})
        check("gd_hover returns a signature", "func call_it() -> int" in hover, hover)

        hover_add = tool_gd_hover({"path": os.path.join(base, "a.gd"), "line": 10, "column": 9})
        check("gd_hover returns the doc comment", "Adds two numbers" in hover_add, hover_add)

        definition = tool_gd_definition({"path": os.path.join(base, "a.gd"), "line": 10, "column": 9})
        check("gd_definition points at the declaration", "a.gd:5:6" in definition, definition)

        references = tool_gd_references({"path": os.path.join(base, "a.gd"), "line": 10, "column": 9})
        check("gd_references counts 2 sites", "2 references" in references, references)
        references_clean = tool_gd_references(
            {"path": os.path.join(base, "a.gd"), "line": 10, "column": 9, "include_declaration": False}
        )
        check("gd_references honours include_declaration", "1 reference " in references_clean, references_clean)

        outline = tool_gd_outline({"path": os.path.join(base, "a.gd")})
        check("gd_outline lists both functions", "func add(" in outline and "func call_it(" in outline, outline)
        filtered = tool_gd_outline({"path": os.path.join(base, "a.gd"), "filter": "^add$"})
        check("gd_outline filters by name", "func add(" in filtered and "call_it" not in filtered, filtered)
        documented = tool_gd_outline({"path": os.path.join(base, "a.gd"), "docs": True})
        check("gd_outline docs=true shows the doc line", "Adds two numbers" in documented, documented)

        diagnostics = tool_gd_diagnostics({"path": os.path.join(base, "broken.gd")})
        check("gd_diagnostics reports the parse error", "Expected parameter name" in diagnostics, diagnostics)
        check(
            "gd_diagnostics uses 1-based lines",
            "broken.gd:4:" in diagnostics,
            diagnostics,
        )
        clean = tool_gd_diagnostics({"path": os.path.join(base, "a.gd")})
        check("gd_diagnostics is quiet on a good file", "no diagnostics" in clean, clean)

        # freshness: rewrite the call site on disk, the answer must follow
        with open(os.path.join(base, "a.gd"), "a", encoding="utf-8") as f:
            f.write("\n\nfunc later() -> int:\n\treturn add(5, 6)\n")
        after = tool_gd_references({"path": os.path.join(base, "a.gd"), "line": 10, "column": 9})
        check("gd_references sees a new call site on disk", "3 references" in after, after)

        with open(os.path.join(base, "broken.gd"), "w", encoding="utf-8") as f:
            f.write("extends Node\n\n\nfunc fixed() -> void:\n\tpass\n")
        fixed = tool_gd_diagnostics({"path": os.path.join(base, "broken.gd")})
        check("gd_diagnostics clears after the fix", "no diagnostics" in fixed, fixed)

        mod_scope = os.path.join(base, "mods", "unfplap")
        os.makedirs(mod_scope, exist_ok=True)
        with open(os.path.join(mod_scope, "check.gd"), "w", encoding="utf-8") as f:
            f.write("extends Node\n\n\nfunc oops(a: int) -> int:\n\treturn a\n")
        result = call_tool("gd_diagnostics", {})
        check("gd_diagnostics with no path scans the mod", "check.gd" in result or "no diagnostics" in result, result)

        state = project.read_state()
        pid = int(state.get("pid") or 0) if state else 0
        shutdown = tool_gd_shutdown({"path": os.path.join(base, "a.gd")})
        time.sleep(0.3)
        check("gd_shutdown stops the daemon", "stopped daemon" in shutdown, shutdown)
        check("gd_shutdown removes the state file", project.read_state() is None)
        check("the daemon process is gone", not process_alive(pid) or not pid_is_our_daemon(pid, base))
        check("the port is closed", state is None or not port_open(state["port"]))
        print("boot+initialize %.1fs" % boot)
    finally:
        try:
            os.chdir(origin)
        except OSError:
            pass
        if project is not None:
            try:
                project.restart()
            except Exception:
                pass
            for path in (project.log_path, project.lock_path):
                try:
                    os.unlink(path)
                except OSError:
                    pass
        shutil.rmtree(base, ignore_errors=True)
        check("the temporary project is gone", not os.path.exists(base), base)

    if failures:
        print("\nSELF-TEST FAILED: %d check(s): %s" % (len(failures), ", ".join(failures)))
        print("server log: %s" % log_path())
        return 1
    print("\nSELF-TEST PASSED")
    return 0


def _self_test_parent():
    parent = "/tmp/opencode"
    if not os.path.isdir(parent):
        parent = tempfile.gettempdir()
    return parent


# --------------------------------------------------------------------------------------
# probe


def probe(tool_name, args_json, root=None):
    if root:
        os.chdir(root)
    args = json.loads(args_json) if args_json else {}
    started = time.time()
    try:
        text = call_tool(tool_name, args)
    except GdlspError as exc:
        print("error: %s" % exc)
        print("log: %s" % log_path())
        return 1
    except OSError as exc:
        print("error: %s" % exc)
        return 1
    print(text)
    sys.stderr.write("(%s took %.2fs)\n" % (tool_name, time.time() - started))
    return 0


# --------------------------------------------------------------------------------------
# entry point


def usage():
    print(
        "usage: gd-lsp-mcp [--self-test | --probe TOOL [JSON] [--root DIR] | --stdio-relay [--root DIR]]\n"
        "\n"
        "  (no arguments)        MCP server over stdin/stdout\n"
        "  --self-test           end-to-end check against a throwaway project in /tmp\n"
        "  --probe TOOL [JSON]   run one tool and print its output\n"
        "  --stdio-relay         bridge an LSP stdio client to the shared daemon\n"
        "\n"
        "environment: GDLSP_GODOT (godot binary), XDG_RUNTIME_DIR (state and logs)"
    )


def main(argv):
    if "--help" in argv or "-h" in argv:
        usage()
        return 0
    if "--version" in argv:
        print("%s %s" % (SERVER_NAME, VERSION))
        return 0
    root = None
    if "--root" in argv:
        index = argv.index("--root")
        if index + 1 < len(argv):
            root = os.path.abspath(argv[index + 1])

    if "--self-test" in argv:
        return self_test()
    if "--stdio-relay" in argv:
        project_root = root or discover_root(os.getcwd())
        if not project_root:
            sys.stderr.write("gd-lsp-mcp: not inside a Godot project (no project.godot)\n")
            return 2
        serve_relay(project_root)
        return 0
    if "--probe" in argv:
        index = argv.index("--probe")
        if index + 1 >= len(argv):
            sys.stderr.write("gd-lsp-mcp: --probe needs a tool name\n")
            return 2
        tool_name = argv[index + 1]
        rest = list(argv[index + 2:])
        if "--root" in rest:
            position = rest.index("--root")
            del rest[position:position + 2]
        args_json = rest[0] if rest else "{}"
        return probe(tool_name, args_json, root)
    serve_mcp()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
