#!/usr/bin/env python3
"""gd-lsp-mcp — MCP tools for exact GDScript navigation through Godot's own language server.

The GDScript knowledge stays where it belongs: in `godot --headless --editor --lsp-port N`.
This file is a supervisor (one headless editor per project root, reused across sessions), an
LSP client (fresh buffers before every query), and a protocol relay (MCP over stdio; and an
LSP-over-stdio bridge for editors that only speak stdio).

Modes:
  gd-lsp-mcp                 MCP server on stdin/stdout (what OpenCode starts)
  gd-lsp-mcp --self-test     end-to-end check against a throwaway project in /tmp
  gd-lsp-mcp --probe TOOL '{"path": ...}'
                             one-shot tool call, for iterating without an editor
  gd-lsp-mcp --stdio-relay   LSP stdio <-> TCP bridge, reusing the same daemon

State and logs live in $XDG_RUNTIME_DIR/gd-lsp (mode 0700): <hash>.json is the record of a
running daemon, <hash>.log its output, <hash>.lock serialises booting.
"""

import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import traceback
import urllib.parse

VERSION = "1.0.0"
SERVER_NAME = "gd-lsp-mcp"

# Generous enough for a cold editor boot and a cold workspace load, which happen once per
# project per machine boot; warm calls are 5-300 ms.
BOOT_READY_TIMEOUT = 240.0
INIT_TIMEOUT = 300.0
REQUEST_TIMEOUT = 10.0
DIAG_WAIT = 2.5
MAX_OPEN_DOCUMENTS = 200
SUPPORTED_PROTOCOLS = ("2025-06-18", "2025-03-26", "2024-11-05")

MOD_FILTER = "mods/unfplap"  # the default scope of `gd_diagnostics` with no path


# --------------------------------------------------------------------------------------
# logging


_LOG_LOCK = threading.Lock()
_LOG_PATH = None


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp/gd-lsp-%d" % os.getuid()
    path = os.path.join(base, "gd-lsp")
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
        os.chmod(path, 0o700)
    except OSError:
        path = os.path.join(tempfile.gettempdir(), "gd-lsp-%d" % os.getuid())
        os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def log_path():
    global _LOG_PATH
    if _LOG_PATH is None:
        _LOG_PATH = os.path.join(runtime_dir(), "mcp.log")
    return _LOG_PATH


def log(msg):
    line = "%s [%d] %s\n" % (time.strftime("%H:%M:%S"), os.getpid(), msg)
    try:
        with _LOG_LOCK:
            with open(log_path(), "a", encoding="utf-8") as f:
                f.write(line)
    except OSError:
        pass


def _trim_log():
    try:
        if os.path.getsize(log_path()) > 2 * 1024 * 1024:
            os.replace(log_path(), log_path() + ".1")
    except OSError:
        pass


# --------------------------------------------------------------------------------------
# errors


class GdlspError(Exception):
    """Base error; the message is shown to the agent."""


class ToolError(GdlspError):
    """Bad arguments or a missing file — never retried."""


class TransportError(GdlspError):
    """Dead socket, timeout, daemon gone — retried once, then reported."""


class ServerError(GdlspError):
    """The language server returned a JSON-RPC error for a well-formed request."""


# --------------------------------------------------------------------------------------
# paths


_ROOT_CACHE = {}


def discover_root(start):
    """Nearest ancestor holding project.godot; `start` may be a file or a directory."""
    start = os.path.abspath(start)
    if start in _ROOT_CACHE:
        return _ROOT_CACHE[start]
    path = start if os.path.isdir(start) else os.path.dirname(start)
    seen = []
    root = None
    while True:
        if path in _ROOT_CACHE:
            root = _ROOT_CACHE[path]
            break
        seen.append(path)
        if os.path.isfile(os.path.join(path, "project.godot")):
            root = path
            break
        parent = os.path.dirname(path)
        if parent == path:
            break
        path = parent
    for p in seen:
        _ROOT_CACHE[p] = root
    _ROOT_CACHE[start] = root
    return root


def path_to_uri(path):
    return "file://" + urllib.parse.quote(os.path.abspath(path), safe="/")


def uri_to_path(uri):
    parsed = urllib.parse.urlparse(uri)
    return urllib.parse.unquote(parsed.path)


def read_text(path):
    with open(path, "rb") as f:
        return f.read().decode("utf-8", "replace")


def rel_path(path, root):
    path = os.path.abspath(path)
    root = os.path.abspath(root)
    if path == root:
        return "."
    if path.startswith(root + os.sep):
        return path[len(root) + 1:]
    return path


def resolve_file(path):
    """Accept absolute paths and paths relative to cwd or to the game project root."""
    if not path:
        raise ToolError("pass a path")
    path = os.path.expanduser(str(path))
    if os.path.isabs(path):
        return path
    candidate = os.path.join(os.getcwd(), path)
    if os.path.exists(candidate):
        return os.path.abspath(candidate)
    root = discover_root(os.getcwd())
    if root:
        candidate = os.path.join(root, path)
        if os.path.exists(candidate):
            return os.path.abspath(candidate)
    return os.path.abspath(os.path.join(os.getcwd(), path))


def process_rss(pid):
    try:
        with open("/proc/%d/status" % pid, encoding="utf-8") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) * 1024
    except OSError:
        return 0
    return 0


def human_bytes(n):
    if n <= 0:
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return "%.1f %s" % (n, unit) if unit != "B" else "%d B" % n
        n /= 1024.0
    return "%d B" % n


def human_age(seconds):
    seconds = int(max(0, seconds))
    if seconds < 90:
        return "%ds" % seconds
    if seconds < 5400:
        return "%dm %ds" % (seconds // 60, seconds % 60)
    return "%dh %dm" % (seconds // 3600, (seconds % 3600) // 60)


def process_alive(pid):
    if pid <= 0:
        return False
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
            stat = f.read()
    except OSError:
        return False
    try:
        state = stat[stat.rindex(")") + 2]
    except (ValueError, IndexError):
        return True
    return state != "Z"  # a zombie we spawned is gone for our purposes


def pid_is_our_daemon(pid, root=None):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            cmdline = f.read().decode("utf-8", "replace")
    except OSError:
        return False
    if "--lsp-port" not in cmdline or "godot" not in cmdline:
        return False
    if root is not None:
        # A recorded pid can be reused by another project's daemon; only ever stop the one
        # whose --path is this project.
        return os.path.realpath(root) in cmdline
    return True


def godot_binary():
    override = os.environ.get("GDLSP_GODOT")
    if override:
        return override
    found = shutil.which("godot")
    if not found:
        raise GdlspError(
            "the `godot` binary was not found on PATH; set GDLSP_GODOT to it"
        )
    return found


def free_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]
    finally:
        s.close()


def port_open(port, timeout=0.6):
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=timeout):
            return True
    except OSError:
        return False


# --------------------------------------------------------------------------------------
# LSP framing


def write_frame(sock, message):
    body = json.dumps(message).encode("utf-8")
    sock.sendall(b"Content-Length: %d\r\n\r\n" % len(body) + body)


def read_frame(stream):
    """Read one Content-Length framed message; None on a clean EOF."""
    headers = {}
    while True:
        line = stream.readline()
        if not line:
            return None
        line = line.strip()
        if not line:
            break
        if b":" in line:
            key, value = line.split(b":", 1)
            headers[key.strip().lower()] = value.strip()
    length = int(headers.get(b"content-length", b"0") or 0)
    if length <= 0:
        return None
    body = stream.read(length)
    if not body or len(body) < length:
        return None
    return json.loads(body.decode("utf-8", "replace"))


def write_frame_stream(stream, message):
    body = json.dumps(message).encode("utf-8")
    stream.write(b"Content-Length: %d\r\n\r\n" % len(body) + body)
    stream.flush()


# --------------------------------------------------------------------------------------
# LSP client (one connection to one daemon)


class LspClient:
    """A single LSP connection. Requests are serialised by the caller; the reader thread
    dispatches responses by id so batched requests overlap their round trips."""

    def __init__(self, root, port):
        self.root = root
        self.port = port
        self.sock = socket.create_connection(("127.0.0.1", int(port)), timeout=10.0)
        self.sock.settimeout(None)
        self.stream = self.sock.makefile("rb")
        self.write_lock = threading.Lock()
        self.state_lock = threading.Lock()
        self.pending = {}
        self.next_id = 0
        self.documents = {}  # uri -> [version, digest]
        self.document_order = []
        self.diagnostics = {}  # path -> (seq, [diagnostic])
        self.diag_seq = 0
        self.closed = False
        self.reader = threading.Thread(target=self._read_loop, daemon=True)
        self.reader.start()

    # -- transport ------------------------------------------------------------------

    def alive(self):
        return not self.closed and self.reader.is_alive()

    def close(self):
        self.closed = True
        # Only the socket is closed: closing the buffered reader under a thread blocked in
        # readline() would deadlock on its internal lock. Shutting the socket down wakes that
        # thread, which then sees EOF and exits.
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass

    def send(self, message):
        with self.write_lock:
            if self.closed:
                raise TransportError("the language server connection is closed")
            try:
                write_frame(self.sock, message)
            except OSError as exc:
                self.closed = True
                raise TransportError("writing to the language server failed: %s" % exc)

    def _read_loop(self):
        while not self.closed:
            try:
                message = read_frame(self.stream)
            except (OSError, ValueError):
                break
            if message is None:
                break
            try:
                self._dispatch(message)
            except Exception:  # a malformed notification must never kill the reader
                log("dispatch failed: %s" % traceback.format_exc())
        self.closed = True
        with self.state_lock:
            pending = list(self.pending.values())
            self.pending.clear()
        for entry in pending:
            entry[1] = TransportError("the language server connection dropped")
            entry[0].set()

    def _dispatch(self, message):
        method = message.get("method")
        if method is None:
            request_id = message.get("id")
            with self.state_lock:
                entry = self.pending.pop(request_id, None)
            if entry is not None:
                if "error" in message:
                    entry[1] = ServerError(
                        "%s: %s" % (message["error"].get("code"), message["error"].get("message"))
                    )
                else:
                    entry[1] = message.get("result")
                entry[0].set()
            return
        if "id" in message:
            # server -> client request: answer "nothing" so the server never blocks on us
            try:
                self.send({"jsonrpc": "2.0", "id": message["id"], "result": None})
            except TransportError:
                pass
            return
        if method == "textDocument/publishDiagnostics":
            params = message.get("params") or {}
            path = uri_to_path(params.get("uri") or "")
            with self.state_lock:
                self.diag_seq += 1
                self.diagnostics[path] = (self.diag_seq, params.get("diagnostics") or [])
            return
        if method in ("window/logMessage", "window/showMessage"):
            params = message.get("params") or {}
            log("godot %s: %s" % (method, str(params.get("message"))[:400]))
            return
        if method == "gdscript/capabilities":
            return
        log("ignored notification %s" % method)

    # -- requests -------------------------------------------------------------------

    def request_async(self, method, params):
        with self.state_lock:
            self.next_id += 1
            request_id = self.next_id
            entry = [threading.Event(), None]
            self.pending[request_id] = entry
        try:
            self.send({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
        except TransportError:
            with self.state_lock:
                self.pending.pop(request_id, None)
            raise
        return request_id, entry

    def wait(self, request_id, entry, timeout=REQUEST_TIMEOUT):
        if not entry[0].wait(timeout):
            with self.state_lock:
                self.pending.pop(request_id, None)
            raise TransportError("the language server did not answer within %.0fs" % timeout)
        if isinstance(entry[1], BaseException):
            raise entry[1]
        return entry[1]

    def request(self, method, params, timeout=REQUEST_TIMEOUT):
        request_id, entry = self.request_async(method, params)
        return self.wait(request_id, entry, timeout)

    def notify(self, method, params):
        self.send({"jsonrpc": "2.0", "method": method, "params": params})

    def initialize(self):
        result = self.request(
            "initialize",
            {
                "processId": None,
                "clientInfo": {"name": SERVER_NAME, "version": VERSION},
                "rootPath": self.root,
                "rootUri": path_to_uri(self.root),
                "capabilities": {
                    "textDocument": {
                        "documentSymbol": {"hierarchicalDocumentSymbolSupport": True},
                        "hover": {"contentFormat": ["markdown", "plaintext"]},
                        "definition": {"linkSupport": False},
                    },
                    "workspace": {"workspaceFolders": False},
                },
            },
            timeout=INIT_TIMEOUT,
        )
        self.notify("initialized", {})
        return result or {}

    # -- documents ------------------------------------------------------------------

    def sync_document(self, path):
        path = os.path.abspath(path)
        if not os.path.isfile(path):
            raise ToolError("no such file: %s" % path)
        text = read_text(path)
        uri = path_to_uri(path)
        digest = hashlib.sha1(text.encode("utf-8", "replace")).hexdigest()
        with self.state_lock:
            known = self.documents.get(uri)
            if known is None:
                send_open, changed, version = True, False, 1
                self.documents[uri] = [version, digest]
                self.document_order.append(uri)
            else:
                send_open = False
                version = known[0] + 1
                changed = known[1] != digest
                if changed:
                    known[0] = version
                    known[1] = digest
                try:
                    self.document_order.remove(uri)
                except ValueError:
                    pass
                self.document_order.append(uri)
            evicted = []
            while len(self.document_order) > MAX_OPEN_DOCUMENTS:
                old = self.document_order.pop(0)
                self.documents.pop(old, None)
                evicted.append(old)
        for old in evicted:
            try:
                self.notify("textDocument/didClose", {"textDocument": {"uri": old}})
            except TransportError:
                pass
        if send_open:
            self.notify(
                "textDocument/didOpen",
                {
                    "textDocument": {
                        "uri": uri,
                        "languageId": "gdscript",
                        "version": version,
                        "text": text,
                    }
                },
            )
        elif changed:
            self.notify(
                "textDocument/didChange",
                {"textDocument": {"uri": uri, "version": version}, "contentChanges": [{"text": text}]},
            )
        return uri, "open" if send_open else ("change" if changed else None)

    def document_count(self):
        with self.state_lock:
            return len(self.documents)

    def diagnostic_snapshot(self):
        with self.state_lock:
            return self.diag_seq

    def wait_for_diagnostics(self, path, since, timeout=DIAG_WAIT, quiet=0.15):
        """(diagnostics, fresh): fresh means a publish arrived after `since`.

        The server republishes whole scripts while it reloads them, so a publish older than
        the change being asked about can land first; wait for the stream to go quiet rather
        than for the first publish."""
        path = os.path.abspath(path)
        deadline = time.time() + timeout
        best = None
        last_seq = None
        quiet_until = None
        while time.time() < deadline:
            with self.state_lock:
                entry = self.diagnostics.get(path)
            if entry is not None and entry[0] > since:
                if entry[0] != last_seq:
                    last_seq = entry[0]
                    best = entry[1]
                    quiet_until = time.time() + quiet
            if quiet_until is not None and time.time() >= quiet_until:
                return best, True
            time.sleep(0.01)
        if best is not None:
            return best, True
        with self.state_lock:
            entry = self.diagnostics.get(path)
        return (entry[1] if entry is not None else None), False

    def diagnostic_entry(self, path):
        with self.state_lock:
            return self.diagnostics.get(os.path.abspath(path))

    def all_diagnostics(self):
        with self.state_lock:
            return dict(self.diagnostics)


# --------------------------------------------------------------------------------------
# project supervisor (one daemon per project root)


class Project:
    def __init__(self, root):
        self.root = os.path.realpath(root)
        digest = hashlib.sha1(self.root.encode("utf-8")).hexdigest()[:12]
        self.hash = digest
        base = runtime_dir()
        self.state_path = os.path.join(base, digest + ".json")
        self.log_path = os.path.join(base, digest + ".log")
        self.lock_path = os.path.join(base, digest + ".lock")
        self.lock = threading.RLock()
        self.client = None
        self.proc = None

    # -- state file -----------------------------------------------------------------

    def read_state(self):
        try:
            with open(self.state_path, encoding="utf-8") as f:
                state = json.load(f)
        except (OSError, ValueError):
            return None
        if not isinstance(state, dict) or not state.get("port"):
            return None
        return state

    def write_state(self, state):
        tmp = self.state_path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=1, sort_keys=True)
        os.replace(tmp, self.state_path)

    def clear_state(self):
        try:
            os.unlink(self.state_path)
        except OSError:
            pass

    def state_or_none(self):
        """The running daemon recorded on disk, if it is still the one we started."""
        state = self.read_state()
        if state and process_alive(int(state.get("pid") or 0)) and port_open(state["port"]):
            return state
        return None

    # -- daemon ---------------------------------------------------------------------

    def _reap(self, pid):
        proc = self.proc
        if proc is not None and proc.pid == pid:
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
            self.proc = None

    def _stop_pid(self, pid, grace=5.0):
        if not pid or not pid_is_our_daemon(pid, self.root):
            return False
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            return False
        deadline = time.time() + grace
        while time.time() < deadline:
            if not process_alive(pid):
                self._reap(pid)
                return True
            time.sleep(0.05)
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
        deadline = time.time() + 3.0
        while time.time() < deadline:
            if not process_alive(pid):
                self._reap(pid)
                return True
            time.sleep(0.05)
        self._reap(pid)
        return not process_alive(pid)

    def _spawn(self, port):
        binary = godot_binary()
        try:
            if os.path.getsize(self.log_path) > 5 * 1024 * 1024:
                os.replace(self.log_path, self.log_path + ".1")
        except OSError:
            pass
        logfile = open(self.log_path, "ab")
        try:
            logfile.write(
                b"\n=== gd-lsp-mcp: booting %s --path %s --lsp-port %d ===\n"
                % (binary.encode(), self.root.encode(), port)
            )
            logfile.flush()
            proc = subprocess.Popen(
                [binary, "--headless", "--editor", "--lsp-port", str(port), "--path", self.root],
                stdin=subprocess.DEVNULL,
                stdout=logfile,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                cwd=self.root,
                close_fds=True,
            )
        finally:
            logfile.close()
        return proc

    def _wait_ready(self, proc, port, timeout=BOOT_READY_TIMEOUT):
        deadline = time.time() + timeout
        while time.time() < deadline:
            if proc.poll() is not None:
                return False
            if port_open(port, timeout=0.3):
                return True
            time.sleep(0.2)
        return False

    def _log_tail(self, lines=12):
        try:
            with open(self.log_path, "rb") as f:
                f.seek(0, os.SEEK_END)
                size = f.tell()
                f.seek(max(0, size - 4000))
                text = f.read().decode("utf-8", "replace")
        except OSError:
            return ""
        stripped = [l for l in text.splitlines() if l.strip()]
        return "\n".join(stripped[-lines:])

    def daemon(self):
        """Return the state dict of a listening daemon, booting one if needed."""
        with self.lock:
            state = self.state_or_none()
            if state:
                return state
            with open(self.lock_path, "a+") as lock_file:
                fcntl.flock(lock_file, fcntl.LOCK_EX)
                try:
                    state = self.state_or_none()
                    if state:
                        return state
                    stale = self.read_state()
                    if stale:
                        pid = int(stale.get("pid") or 0)
                        if process_alive(pid) and pid_is_our_daemon(pid, self.root):
                            if self._wait_ready_proc(pid, stale["port"], 90.0):
                                return stale
                            self._stop_pid(pid)
                        self.clear_state()
                    return self._boot()
                finally:
                    fcntl.flock(lock_file, fcntl.LOCK_UN)

    def _wait_ready_proc(self, pid, port, timeout):
        deadline = time.time() + timeout
        while time.time() < deadline:
            if port_open(port, timeout=0.3):
                return True
            if not process_alive(pid):
                return False
            time.sleep(0.2)
        return False

    def _boot(self):
        last_error = None
        for attempt in range(3):
            port = free_port()
            log("booting godot for %s on port %d (attempt %d)" % (self.root, port, attempt + 1))
            try:
                proc = self._spawn(port)
                self.proc = proc
            except OSError as exc:
                raise GdlspError("could not start godot: %s (see %s)" % (exc, self.log_path))
            if self._wait_ready(proc, port):
                state = {
                    "root": self.root,
                    "port": port,
                    "pid": proc.pid,
                    "started_at": time.time(),
                    "log": self.log_path,
                    "godot": godot_binary(),
                    "mcp_pid": os.getpid(),
                }
                self.write_state(state)
                log("godot listening on port %d (pid %d)" % (port, proc.pid))
                return state
            last_error = self._log_tail()
            try:
                proc.kill()
            except OSError:
                pass
            self._reap(proc.pid)
            log("boot attempt %d failed for %s" % (attempt + 1, self.root))
        raise GdlspError(
            "godot did not start a language server for %s. Log: %s\n%s"
            % (self.root, self.log_path, last_error or "")
        )

    # -- client ---------------------------------------------------------------------

    def ensure_client(self, force_new=False):
        with self.lock:
            if self.client is not None and not force_new and self.client.alive():
                return self.client
            if self.client is not None:
                self.client.close()
                self.client = None
            state = self.daemon()
            client = LspClient(self.root, state["port"])
            try:
                client.initialize()
            except GdlspError:
                client.close()
                raise
            self.client = client
            return client

    def drop_client(self):
        with self.lock:
            if self.client is not None:
                self.client.close()
                self.client = None

    def restart(self):
        """Kill the daemon and forget it; the next ensure_client boots a fresh one."""
        with self.lock:
            self.drop_client()
            state = self.read_state()
            self.clear_state()
            if state:
                self._stop_pid(int(state.get("pid") or 0))

    def run(self, paths, fn):
        """Sync the documents a query reads, run fn(client), and recover from a dead or
        wedged connection: reconnect once, then restart the daemon once."""
        paths = [p for p in paths if p]
        attempts = []
        for force_new in (False, True):
            try:
                client = self.ensure_client(force_new=force_new)
                for path in paths:
                    client.sync_document(path)
                return fn(client)
            except TransportError as exc:
                attempts.append(str(exc))
                log("query failed on %s: %s" % (self.root, exc))
                self.drop_client()
        self.restart()
        client = self.ensure_client()
        try:
            for path in paths:
                client.sync_document(path)
            return fn(client)
        except TransportError as exc:
            attempts.append(str(exc))
            raise GdlspError(
                "the language server for %s keeps failing (%s). Daemon log: %s"
                % (self.root, "; ".join(attempts) or exc, self.log_path)
            )

    def status_text(self):
        lines = []
        # Status must never boot a 3.6 GB editor as a side effect: report what is running.
        state = self.state_or_none()
        if not state:
            lines.append("root     %s" % self.root)
            lines.append("state    not running")
            lines.append("log      %s" % self.log_path)
            return "\n".join(lines)
        pid = int(state.get("pid") or 0)
        started = float(state.get("started_at") or 0)
        client = self.client
        lines.append("root     %s" % self.root)
        lines.append("port     %s" % state.get("port", "?"))
        lines.append("pid      %s" % (pid or "?"))
        if started:
            lines.append("uptime   %s" % human_age(time.time() - started))
        lines.append("rss      %s" % human_bytes(process_rss(pid)))
        if client is not None:
            known = client.all_diagnostics()
            flagged = sum(1 for _, (_, diags) in known.items() if diags)
            lines.append(
                "buffers  %d open, %d known files with diagnostics"
                % (client.document_count(), flagged)
            )
        lines.append("log      %s" % self.log_path)
        lines.append("state    %s" % self.state_path)
        return "\n".join(lines)


_PROJECTS = {}
_PROJECTS_LOCK = threading.Lock()


def project_for(root):
    root = os.path.realpath(root)
    with _PROJECTS_LOCK:
        project = _PROJECTS.get(root)
        if project is None:
            project = Project(root)
            _PROJECTS[root] = project
        return project


def project_for_path(path):
    resolved = resolve_file(path)
    root = discover_root(resolved if os.path.isdir(resolved) else os.path.dirname(resolved))
    if not root:
        raise ToolError(
            "%s is not inside a Godot project (no project.godot found above it)" % resolved
        )
    return project_for(root), resolved


def project_for_cwd():
    root = discover_root(os.getcwd())
    if not root:
        raise ToolError("the current directory is not inside a Godot project (no project.godot)")
    return project_for(root)


