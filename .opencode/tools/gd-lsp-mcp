def _position_args(args, path):
    line, column = resolve_position(path, args)
    return {"line": line - 1, "character": column - 1}, line, column


def tool_gd_hover(args):
    project, path = project_for_path(args.get("path"))
    position, line, column = _position_args(args, path)
    uri = path_to_uri(path)

    def run(client):
        return client.request(
            "textDocument/hover", {"textDocument": {"uri": uri}, "position": position}
        )

    result = project.run([path], run)
    lines = hover_text(result)
    head = "%s:%d:%d" % (rel_path(path, project.root), line, column)
    if not lines:
        return "%s  (no hover information)" % head
    out = ["%s  %s" % (head, lines[0])]
    for extra in lines[1:9]:
        out.append("    %s" % extra if extra else "")
    if len(lines) > 9:
        out.append("    ...")
    return "\n".join(out).rstrip("\n")


def tool_gd_definition(args):
    project, path = project_for_path(args.get("path"))
    position, line, column = _position_args(args, path)
    uri = path_to_uri(path)

    def run(client):
        return client.request(
            "textDocument/definition", {"textDocument": {"uri": uri}, "position": position}
        )

    result = project.run([path], run)
    locations = [format_location(loc, project.root) for loc in location_list(result)]
    seen = []
    for item in locations:
        if item not in seen:
            seen.append(item)
    head = "%s:%d:%d" % (rel_path(path, project.root), line, column)
    if not seen:
        return "%s  no definition found" % head
    return "\n".join([head + "  ->"] + seen)


def tool_gd_references(args):
    project, path = project_for_path(args.get("path"))
    position, line, column = _position_args(args, path)
    uri = path_to_uri(path)
    include = args.get("include_declaration", True)
    if isinstance(include, str):
        include = include.lower() not in ("false", "0", "no")
    try:
        maximum = int(args.get("max") or 50)
    except (TypeError, ValueError):
        raise ToolError("`max` must be an integer")

    def run(client):
        references = client.request(
            "textDocument/references",
            {
                "textDocument": {"uri": uri},
                "position": position,
                "context": {"includeDeclaration": bool(include)},
            },
        )
        declaration = None
        if not include:
            # Godot ignores includeDeclaration, so the declaration is filtered here.
            try:
                declaration = client.request(
                    "textDocument/definition", {"textDocument": {"uri": uri}, "position": position}
                )
            except ServerError:
                declaration = None
        return references, declaration

    references, declaration = project.run([path], run)
    declared = set()
    for loc in location_list(declaration):
        start = (loc.get("range") or {}).get("start") or {}
        declared.add(
            (
                os.path.abspath(uri_to_path(loc.get("uri") or "")),
                int(start.get("line", -1)),
                int(start.get("character", -1)),
            )
        )
    sites = []
    for loc in location_list(references):
        start = (loc.get("range") or {}).get("start") or {}
        target = os.path.abspath(uri_to_path(loc.get("uri") or ""))
        if not include and (
            target,
            int(start.get("line", -1)),
            int(start.get("character", -1)),
        ) in declared:
            continue
        sites.append((target, loc))
    sites.sort(key=lambda item: (
        rel_path(item[0], project.root),
        int(((item[1].get("range") or {}).get("start") or {}).get("line", 0)),
        int(((item[1].get("range") or {}).get("start") or {}).get("character", 0)),
    ))
    head = "%s:%d:%d" % (rel_path(path, project.root), line, column)
    if not sites:
        return "%s  no references found" % head
    files = len({item[0] for item in sites})
    title = "%s  %d reference%s in %d file%s%s" % (
        head,
        len(sites),
        "" if len(sites) == 1 else "s",
        files,
        "" if files == 1 else "s",
        "" if include else " (declaration excluded)",
    )
    out = [title]
    for target, loc in sites[:maximum]:
        out.append("  " + format_location(loc, project.root))
    if len(sites) > maximum:
        out.append("  ... %d more (raise max)" % (len(sites) - maximum))
    return "\n".join(out)


def _flatten_symbols(symbols, depth=0):
    for symbol in symbols:
        yield symbol, depth
        children = symbol.get("children") or []
        if children:
            yield from _flatten_symbols(children, depth + 1)


def _symbol_label(symbol):
    detail = (symbol.get("detail") or "").strip()
    label = detail or (symbol.get("name") or "?")
    label = " ".join(label.split())
    if len(label) > 110:
        label = label[:109] + "…"
    return label


def tool_gd_outline(args):
    project, path = project_for_path(args.get("path"))
    uri = path_to_uri(path)
    filter_text = args.get("filter")
    docs = bool(args.get("docs"))
    try:
        maximum = int(args.get("max") or 100)
    except (TypeError, ValueError):
        raise ToolError("`max` must be an integer")
    pattern = None
    if filter_text:
        try:
            pattern = re.compile(str(filter_text))
        except re.error as exc:
            raise ToolError("`filter` is not a valid regular expression: %s" % exc)

    def run(client):
        return client.request("textDocument/documentSymbol", {"textDocument": {"uri": uri}})

    result = project.run([path], run) or []
    symbols = list(result) if isinstance(result, list) else []
    header_note = ""
    if len(symbols) == 1 and (symbols[0].get("children") or []):
        root_symbol = symbols[0]
        symbols = root_symbol.get("children") or []
        header_note = " (in %s)" % (root_symbol.get("name") or "class")
    entries = list(_flatten_symbols(symbols))
    if pattern is not None:
        def keep(items, depth):
            out = []
            for symbol in items:
                children = symbol.get("children") or []
                if pattern.search(symbol.get("name") or ""):
                    out.append((symbol, depth))
                    out.extend(_flatten_symbols(children, depth + 1))
                else:
                    out.extend(keep(children, depth))
            return out

        entries = keep(symbols, 0)
    total = len(entries)
    out = ["%s  %d symbol%s%s" % (
        rel_path(path, project.root),
        total,
        "" if total == 1 else "s",
        header_note,
    )]
    for symbol, depth in entries[:maximum]:
        rng = symbol.get("range") or {}
        start = int((rng.get("start") or {}).get("line", 0)) + 1
        end = int((rng.get("end") or {}).get("line", 0)) + 1
        label = _symbol_label(symbol)
        if docs:
            text = " ".join((symbol.get("documentation") or "").split())
            if text:
                label += "  — %s" % (text[:120] + ("…" if len(text) > 120 else ""))
        out.append("%sL%d-%d  %s" % ("  " * depth, start, end, label))
    if total > maximum:
        out.append("... %d more (raise max)" % (total - maximum))
    return "\n".join(out)


def _diagnostics_for_path(project, path):
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        raise ToolError("no such file: %s" % path)

    def run(client):
        known = client.diagnostic_entry(path)
        since = client.diagnostic_snapshot()
        uri, sent = client.sync_document(path)
        if sent is None and known is not None:
            return known[1]
        diagnostics, fresh = client.wait_for_diagnostics(path, since)
        if not fresh:
            # No new publish: either the file really is clean or the connection stopped
            # answering (a wedged editor thread looks exactly like this). A cheap request
            # tells the two apart; a timeout raises TransportError and `run` reconnects.
            client.request(
                "textDocument/documentSymbol", {"textDocument": {"uri": uri}}, timeout=5.0
            )
        return diagnostics

    # fn syncs the document itself, so `run` must not sync it first: a second sync would
    # see "unchanged" and the shortcut above would answer from the pre-change publish.
    return project.run([], run)


_MOD_SCAN_CACHE = {}
_MOD_SCAN_LOCK = threading.Lock()


def _mod_files(root):
    base = os.path.join(root, MOD_FILTER)
    files = []
    for dirpath, dirnames, filenames in os.walk(base):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for name in filenames:
            if name.endswith(".gd"):
                files.append(os.path.join(dirpath, name))
    return sorted(files)


def tool_gd_diagnostics(args):
    if args.get("path"):
        project, path = project_for_path(args["path"])
        diagnostics = _diagnostics_for_path(project, path)
        rel = rel_path(path, project.root)
        if diagnostics is None:
            return "%s  no diagnostics published" % rel
        if not diagnostics:
            return "%s  no diagnostics" % rel
        out = ["%s  %d diagnostic%s" % (rel, len(diagnostics), "" if len(diagnostics) == 1 else "s")]
        for diagnostic in diagnostics:
            out.append("  " + format_diagnostic(path, diagnostic, project.root))
        return "\n".join(out)

    project = project_for_cwd()
    budget = float(args.get("budget") or 30.0)
    started = time.time()
    prefix = os.path.join(project.root, MOD_FILTER) + os.sep
    try:
        client = project.ensure_client()
        known_paths = {os.path.abspath(p) for p in client.all_diagnostics()}
    except GdlspError as exc:
        # `run` below owns recovery; a cold or wedged connection must not fail the scan here.
        log("diagnostics scan: %s" % exc)
        known_paths = set()
    covered = sum(1 for p in known_paths if p.startswith(prefix))
    state = project.read_state() or {}
    booted_at = float(state.get("started_at") or 0)
    files = _mod_files(project.root)
    scanned = [0]

    def scan(client):
        fresh = []
        for path in files:
            try:
                stat = os.stat(path)
            except OSError:
                continue
            key = (stat.st_mtime_ns, stat.st_size)
            if path in known_paths and booted_at and stat.st_mtime < booted_at - 5:
                # this connection already has the daemon's verdict for an unchanged file
                with _MOD_SCAN_LOCK:
                    _MOD_SCAN_CACHE[path] = key
                continue
            with _MOD_SCAN_LOCK:
                if _MOD_SCAN_CACHE.get(path) == key:
                    continue
            fresh.append((path, key))
        batch = []
        deadline = started + budget
        for path, key in fresh:
            if time.time() > deadline:
                break
            batch.append((path, key))
            if len(batch) >= 25:
                _flush_mod_batch(client, batch)
                scanned[0] += len(batch)
                batch = []
        if batch:
            _flush_mod_batch(client, batch)
            scanned[0] += len(batch)

    project.run([], scan)
    known = project.client.all_diagnostics() if project.client else {}
    rows = []
    errors = warnings = others = 0
    for path, (_seq, diagnostics) in sorted(known.items()):
        if not diagnostics or not os.path.abspath(path).startswith(prefix):
            continue
        for diagnostic in diagnostics:
            severity = int(diagnostic.get("severity") or 1)
            if severity == 1:
                errors += 1
            elif severity == 2:
                warnings += 1
            else:
                others += 1
            start = (diagnostic.get("range") or {}).get("start") or {}
            rows.append(
                (
                    severity,
                    rel_path(path, project.root),
                    int(start.get("line", 0)),
                    format_diagnostic(path, diagnostic, project.root),
                )
            )
    # Errors first: a project-wide scan is mostly pre-existing warnings, and the one new
    # error must not be buried under them.
    rows.sort(key=lambda row: (row[0], row[1], row[2]))
    took = time.time() - started
    summary = "%d files, %d reparsed, %.1fs" % (len(files), scanned[0], took)
    if not rows:
        return "no diagnostics under %s/** (%s)%s" % (
            MOD_FILTER,
            summary,
            "" if covered else "; the daemon has not scanned the workspace yet",
        )
    counts = "%d error%s, %d warning%s" % (
        errors,
        "" if errors == 1 else "s",
        warnings,
        "" if warnings == 1 else "s",
    )
    if others:
        counts += ", %d other" % others
    out = [
        "%d diagnostic%s under %s/** (%s; %s)"
        % (len(rows), "" if len(rows) == 1 else "s", MOD_FILTER, counts, summary)
    ]
    out.extend(row[3] for row in rows[:400])
    if len(rows) > 400:
        out.append("... %d more" % (len(rows) - 400))
    return "\n".join(out)


def _flush_mod_batch(client, batch):
    for path, _key in batch:
        client.sync_document(path)
    deadline = time.time() + 3.0
    pending = list(batch)
    while pending and time.time() < deadline:
        pending = [(path, key) for path, key in pending if client.diagnostic_entry(path) is None]
        if pending:
            time.sleep(0.02)
    with _MOD_SCAN_LOCK:
        for path, key in batch:
            _MOD_SCAN_CACHE[path] = key


def tool_gd_status(args):
    project = project_for_cwd() if not args.get("path") else project_for_path(args["path"])[0]
    return project.status_text()


def tool_gd_shutdown(args):
    if args.get("path"):
        project = project_for_path(args["path"])[0]
    else:
        root = discover_root(os.getcwd())
        if not root:
            raise ToolError("the current directory is not inside a Godot project")
        project = project_for(root)
    state = project.read_state()
    if not state:
        return "no daemon recorded for %s" % project.root
    pid = int(state.get("pid") or 0)
    port = state.get("port")
    project.drop_client()
    stopped = project._stop_pid(pid)
    project.clear_state()
    _MOD_SCAN_CACHE.clear()
    if not stopped:
        return "daemon for %s (pid %d) did not exit" % (project.root, pid)
    return "stopped daemon for %s (pid %d, port %s)" % (project.root, pid, port)


