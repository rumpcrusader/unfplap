            "properties": {"path": {"type": "string", "description": "any file inside the project"}},
        },
    },
]

TOOL_FUNCTIONS = {
    "gd_hover": tool_gd_hover,
    "gd_definition": tool_gd_definition,
    "gd_references": tool_gd_references,
    "gd_outline": tool_gd_outline,
    "gd_diagnostics": tool_gd_diagnostics,
    "gd_status": tool_gd_status,
    "gd_shutdown": tool_gd_shutdown,
}


def call_tool(name, args):
    function = TOOL_FUNCTIONS.get(name)
    if function is None:
        raise ToolError("unknown tool %r; available: %s" % (name, ", ".join(TOOL_FUNCTIONS)))
    if not isinstance(args, dict):
        args = {}
    return function(args)


# --------------------------------------------------------------------------------------
# MCP over stdio


def mcp_send(message):
    data = json.dumps(message).encode("utf-8")
    out = sys.stdout.buffer
    out.write(data + b"\n")
    out.flush()


def mcp_result(request_id, result):
    return {"jsonrpc": "2.0", "id": request_id, "result": result}


def mcp_error(request_id, code, message):
    return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": message}}


def tool_content(text, is_error=False):
    return {"content": [{"type": "text", "text": text}], "isError": is_error}


def warm_up():
    """Boot and initialize the daemon for the current project in the background, so the
    first real call does not pay for a cold editor."""
    try:
        root = discover_root(os.getcwd())
        if not root:
            log("warm-up: cwd is not inside a Godot project, skipping")
            return
        started = time.time()
        project_for(root).ensure_client()
        log("warm-up: %s ready in %.1fs" % (root, time.time() - started))
    except Exception as exc:
        log("warm-up failed: %s" % exc)


def serve_mcp():
    _trim_log()
    log("mcp server started (cwd %s)" % os.getcwd())
    threading.Thread(target=warm_up, daemon=True).start()
    stream = sys.stdin.buffer
    for line in stream:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line.decode("utf-8", "replace"))
        except ValueError:
            mcp_send(mcp_error(None, -32700, "parse error"))
            continue
        method = message.get("method")
        request_id = message.get("id")
        is_notification = request_id is None
        try:
            if method == "initialize":
                params = message.get("params") or {}
                requested = params.get("protocolVersion")
                version = requested if requested in SUPPORTED_PROTOCOLS else SUPPORTED_PROTOCOLS[0]
                mcp_send(
                    mcp_result(
                        request_id,
                        {
                            "protocolVersion": version,
                            "capabilities": {"tools": {"listChanged": False}},
                            "serverInfo": {"name": SERVER_NAME, "version": VERSION},
                        },
                    )
                )
            elif method == "tools/list":
                mcp_send(mcp_result(request_id, {"tools": TOOL_DEFINITIONS}))
            elif method == "tools/call":
                params = message.get("params") or {}
                name = params.get("name") or ""
                arguments = params.get("arguments") or {}
                log("tools/call %s %s" % (name, json.dumps(arguments)[:200]))
                started = time.time()
                try:
                    text = call_tool(name, arguments)
                    mcp_send(mcp_result(request_id, tool_content(text)))
                except GdlspError as exc:
                    # `isError` already marks this as a failure; a second "error:" prefix
                    # would reach the agent as "Error: error: ...".
                    mcp_send(mcp_result(request_id, tool_content(str(exc), True)))
                except Exception:
                    detail = traceback.format_exc()
                    log("tools/call %s crashed: %s" % (name, detail))
                    mcp_send(
                        mcp_result(
                            request_id,
                            tool_content(
                                "%s failed: %s (log: %s)"
                                % (name, detail.strip().splitlines()[-1], log_path()),
                                True,
                            ),
                        )
                    )
                finally:
                    log("tools/call %s took %.2fs" % (name, time.time() - started))
            elif method == "ping":
                mcp_send(mcp_result(request_id, {}))
            elif method == "shutdown":
                mcp_send(mcp_result(request_id, None))
            elif method == "exit":
                break
            elif is_notification:
                pass
            else:
                mcp_send(mcp_error(request_id, -32601, "method not found: %s" % method))
        except BrokenPipeError:
            break
        except Exception:
            log("mcp loop error: %s" % traceback.format_exc())
            if not is_notification:
                mcp_send(mcp_error(request_id, -32603, "internal error"))
    log("mcp server exiting")


# --------------------------------------------------------------------------------------
# LSP stdio <-> TCP relay


class Relay:
    """Forwards an editor's stdio LSP session to the shared daemon, rewriting the workspace
    root (the editor's root is often a sub-directory of the game project)."""

    def __init__(self, root):
        self.root = root
        self.project = project_for(root)
        self.sock = None
        self.stream = None
        self.documents = {}
        self.write_lock = threading.Lock()
        self.docs_lock = threading.Lock()
        self.out_lock = threading.Lock()

    def connect(self):
        if self.sock is not None:
            return
        state = self.project.daemon()
        for _ in range(3):
            try:
                self.sock = socket.create_connection(("127.0.0.1", int(state["port"])), timeout=15.0)
                self.sock.settimeout(None)
                self.stream = self.sock.makefile("rb")
                return
            except OSError:
                time.sleep(0.2)
                state = self.project.daemon()
        raise GdlspError("could not connect to the daemon on port %s" % state.get("port"))

    def send_upstream(self, message):
        with self.write_lock:
            write_frame(self.sock, message)

    def _rewrite_initialize(self, message):
        params = dict(message.get("params") or {})
        params["rootPath"] = self.root
        params["rootUri"] = path_to_uri(self.root)
        if "workspaceFolders" in params:
            params["workspaceFolders"] = [{"uri": path_to_uri(self.root), "name": os.path.basename(self.root)}]
        return dict(message, params=params)

    def _track(self, message):
        method = message.get("method")
        params = message.get("params") or {}
        if method in ("textDocument/didOpen", "textDocument/didChange"):
            document = params.get("textDocument") or {}
            uri = document.get("uri")
            changes = params.get("contentChanges") or []
            text = changes[-1].get("text") if changes else None
            if method == "textDocument/didOpen":
                text = (document.get("text") if text is None else text)
            if not uri:
                return
            with self.docs_lock:
                entry = self.documents.setdefault(uri, {"text": "", "languageId": "gdscript"})
                if text is not None:
                    entry["text"] = text
        elif method == "textDocument/didClose":
            uri = (params.get("textDocument") or {}).get("uri")
            with self.docs_lock:
                self.documents.pop(uri, None)

    def _replay(self):
        """After a reconnect the daemon has no buffers for this session: re-open them."""
        with self.docs_lock:
            documents = dict(self.documents)
        for uri, entry in documents.items():
            try:
                self.send_upstream(
                    {
                        "jsonrpc": "2.0",
                        "method": "textDocument/didOpen",
                        "params": {
                            "textDocument": {
                                "uri": uri,
                                "languageId": entry.get("languageId") or "gdscript",
                                "version": 1,
                                "text": entry.get("text") or read_text(uri_to_path(uri)),
                            }
                        },
                    }
                )
            except GDLSP_RELAY_ERRORS:
                return

    def up(self):
        stdin = sys.stdin.buffer
        while True:
            try:
                message = read_frame(stdin)
            except (OSError, ValueError):
                break
            if message is None:
                break
            if message.get("method") == "initialize":
                message = self._rewrite_initialize(message)
                try:
                    self.connect()
                except GdlspError as exc:
                    log("relay: %s" % exc)
                    with self.out_lock:
                        write_frame_stream(
                            sys.stdout.buffer,
                            {
                                "jsonrpc": "2.0",
                                "id": message.get("id"),
                                "error": {"code": -32002, "message": str(exc)},
                            },
                        )
                    continue
            self._track(message)
            try:
                if self.sock is None:
                    self.connect()
                self.send_upstream(message)
            except GDLSP_RELAY_ERRORS:
                log("relay: upstream write failed, reconnecting")
                self.sock = None
                try:
                    self.connect()
                    self.send_upstream(
                        {
                            "jsonrpc": "2.0",
                            "id": -1,
                            "method": "initialize",
                            "params": {
                                "rootPath": self.root,
                                "rootUri": path_to_uri(self.root),
                                "capabilities": {},
                            },
                        }
                    )
                    self.send_upstream({"jsonrpc": "2.0", "method": "initialized", "params": {}})
                    self._replay()
                    self.send_upstream(message)
                except GDLSP_RELAY_ERRORS:
                    log("relay: reconnect failed")
                    break
            if message.get("method") == "exit":
                break
        log("relay: stdin closed")

    def down(self):
        while True:
            try:
                message = read_frame(self.stream)
            except (OSError, ValueError):
                break
            if message is None:
                break
            if message.get("id") == -1 and message.get("method") is None:
                # the relay's own reconnect handshake, not something the editor asked for
                continue
            try:
                with self.out_lock:
                    write_frame_stream(sys.stdout.buffer, message)
            except (BrokenPipeError, OSError):
                break
        log("relay: daemon closed")


GDLSP_RELAY_ERRORS = (OSError, ValueError, GdlspError)


def serve_relay(root):
    _trim_log()
    log("relay started for %s (cwd %s)" % (root, os.getcwd()))
    relay = Relay(root)
    relay.connect()
    threading.Thread(target=relay.down, daemon=True).start()
    relay.up()


