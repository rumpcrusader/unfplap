excluded_directories:
- .git
- .godot
- dist
- sources
- assets

disable:
- class-definitions-order
- max-line-length
- max-file-lines
- max-public-methods
- max-returns
- unnecessary-pass
- unused-argument
- comparison-with-itself
- sub-class-name

function-arguments-number: 14
constant-name: (_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*|([A-Z][a-z0-9]*)+)
class-variable-name: (_?[a-z][a-z0-9]*(_[a-z0-9]+)*|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)
