_IDENT = re.compile(r"[A-Za-z0-9_]")


def position_from_symbol(text, symbol):
    lines = text.splitlines()
    for number, line in enumerate(lines, 1):
        start = 0
        while True:
            index = line.find(symbol, start)
            if index < 0:
                break
            before = line[index - 1] if index > 0 else " "
            after = line[index + len(symbol)] if index + len(symbol) < len(line) else " "
            if not _IDENT.match(before) and not _IDENT.match(after):
                return number, index + 1
            start = index + 1
    raise ToolError("symbol %r does not appear in the file" % symbol)


def resolve_position(path, args):
    if not os.path.isfile(path):
        raise ToolError("no such file: %s" % path)
    text = read_text(path)
    if args.get("symbol"):
        line, column = position_from_symbol(text, str(args["symbol"]))
        return line, column
    if args.get("line") is None:
        raise ToolError("pass `line` (+ optional `column`) or `symbol`")
    try:
        line = int(args["line"])
    except (TypeError, ValueError):
        raise ToolError("`line` must be an integer (1-based)")
    column = args.get("column")
    column = int(column) if column not in (None, "") else 1
    total = len(text.splitlines()) or 1
    if line < 1 or line > total:
        raise ToolError("line %d is outside %s (%d lines)" % (line, os.path.basename(path), total))
    return line, max(1, column)


def hover_text(result):
    contents = (result or {}).get("contents")
    value = ""
    if isinstance(contents, dict):
        value = contents.get("value") or ""
    elif isinstance(contents, str):
        value = contents
    elif isinstance(contents, list):
        parts = []
        for item in contents:
            parts.append(item.get("value") or "" if isinstance(item, dict) else str(item))
        value = "\n".join(parts)
    out = []
    for raw in value.splitlines():
        line = raw.strip()
        if line.startswith("Defined in"):
            break
        if line and set(line) <= set("-*_ "):
            continue
        out.append(line)
    while out and not out[0]:
        out.pop(0)
    while out and not out[-1]:
        out.pop()
    return out


def location_list(result):
    if result is None:
        return []
    if isinstance(result, dict):
        return [result]
    return [item for item in result if isinstance(item, dict)]


def format_location(loc, root):
    uri = loc.get("uri") or (loc.get("targetUri") or "")
    rng = loc.get("range") or loc.get("targetSelectionRange") or loc.get("targetRange") or {}
    start = rng.get("start") or {}
    return "%s:%d:%d" % (
        rel_path(uri_to_path(uri), root),
        int(start.get("line", 0)) + 1,
        int(start.get("character", 0)) + 1,
    )


def format_diagnostic(path, diagnostic, root):
    rng = diagnostic.get("range") or {}
    start = rng.get("start") or {}
    severity = {1: "error", 2: "warning", 3: "info", 4: "hint"}.get(
        int(diagnostic.get("severity") or 1), "error"
    )
    code = diagnostic.get("code")
    tag = severity if code in (None, -1) else "%s[%s]" % (severity, code)
    return "%s:%d:%d  %s: %s" % (
        rel_path(path, root),
        int(start.get("line", 0)) + 1,
        int(start.get("character", 0)) + 1,
        tag,
        (diagnostic.get("message") or "").strip().replace("\n", " "),
    )


